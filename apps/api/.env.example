DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motorcycle_parts?schema=public"
# Refused at boot if unset, shorter than 32 characters, or left as a placeholder.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
# Storefront (portal) tokens only. Office access tokens last 1h and are renewed
# by a 30-day rolling refresh token (BUSINESS_LOGIC §23).
JWT_EXPIRATION="24h"
PORT=3001
NODE_ENV=development

# --- Deployment (Vercel) -----------------------------------------------------
# Where the two frontends are served from. Localhost is always allowed; these
# add the deployed origins to CORS. Without them a deployed frontend gets a
# browser-side network error with nothing in the API log to explain it.
WEB_ORIGIN="https://your-office-app.vercel.app"
STORE_ORIGIN="https://your-store.vercel.app"

# Shared secret for scheduled jobs. Vercel sends it as `Authorization: Bearer`
# on every cron request. /jobs/sweep-holds refuses when it is unset, because an
# open endpoint that expires reservations is worse than one that never runs.
CRON_SECRET=""

# Set automatically when a Vercel Blob store is attached. Its presence is what
# switches file storage off local disk — Vercel wipes the filesystem on every
# deploy, so without it every product photo and customer picture is lost.
BLOB_READ_WRITE_TOKEN=""

# Office push alerts (BUSINESS_LOGIC §10). Without these the Settings page shows
# no "Alerts on this device" section and no alert is pushed. Generate a pair:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@motoparts.local

# The office chat (owner 2026-10-25). No key: the chat says it is not set up.
# Any OpenAI-compatible provider; switch with no code change.
#   AI_PROVIDER  gemini (default) | groq | openai | openrouter — or any, with AI_BASE_URL
#   AI_MODEL     optional; defaults: gemini-2.5-flash, openai/gpt-oss-120b (groq), gpt-4o-mini
#   AI_DAILY_LIMIT  questions a day, shared by the partners (default 100)
# Groq's free tier (8,000 tokens a minute) is too small for one question with the
# assistant's tools (2026-10-25); Gemini's free tier fits.
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_DAILY_LIMIT=100
