DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motorcycle_parts?schema=public"
# Refused at boot if unset, shorter than 32 characters, or left as a placeholder.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EXPIRATION="24h"
PORT=3001
NODE_ENV=development

# --- Deployment (Vercel) -----------------------------------------------------
# Where the two frontends are served from. Localhost is always allowed; these
# add the deployed origins to CORS. Without them a deployed frontend gets a
# browser-side network error with nothing in the API log to explain it.
WEB_ORIGIN="https://your-office-app.vercel.app"
STORE_ORIGIN="https://your-store.vercel.app"

# Shared secret for scheduled jobs. Vercel sends it as `Authorization: Bearer`
# on every cron request. /jobs/sweep-holds refuses when it is unset, because an
# open endpoint that expires reservations is worse than one that never runs.
CRON_SECRET=""

# Set automatically when a Vercel Blob store is attached. Its presence is what
# switches file storage off local disk — Vercel wipes the filesystem on every
# deploy, so without it every product photo and customer picture is lost.
BLOB_READ_WRITE_TOKEN=""
