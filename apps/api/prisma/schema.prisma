generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Auth ───────────────────────────────────────────────

enum UserRole {
  CORE_PARTNER
  TEMP_INVESTOR
  ADMIN_SUPPORT
  SHOP_OWNER_PORTAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  version      Int        @default(1)

  partner               Partner?
  auditLogs             AuditLog[]
  notifications         Notification[]
  cyclePartnerEntries   CycleParticipant[]     @relation("CyclePartnerUser")
  cycleInvestorEntries  CycleParticipant[]     @relation("CycleInvestorUser")
  /// What this core partner's payouts were charged for running costs (§8, L7).
  runningCostCharges    RunningCostCharge[]
  /// His fixed share of each running cost of his time (§8, L7).
  runningCostShares     RunningCostShare[]
  saleOrders            SaleOrder[]            @relation("CreatedSaleOrderUser")
  payments              Payment[]              @relation("CreatedPaymentUser")
  productRequests       ProductRequest[]       @relation("CreatedProductRequestUser")
  financialTransactions FinancialTransaction[]
  inventoryMovements    InventoryMovement[]
  stockTransfers        StockTransfer[]        @relation("StockTransferCreatedBy")
  stockTransfersUndone  StockTransfer[]        @relation("StockTransferReversedBy")

  createdSaleReturns SaleReturn[] @relation("CreatedSaleReturnUser")

  createdPaymentPlans PaymentPlan[] @relation("CreatedPaymentPlanUser")

  /**
   * The shop this login belongs to, for a SHOP_OWNER_PORTAL account.
   */
  portalCustomer Customer? @relation("PortalAccount")

  pushSubscriptions    PushSubscription[]
  decidedOrderRequests OrderRequest[]      @relation("DecidedOrderRequestUser")
  oauthRefreshTokens   OAuthRefreshToken[]
  sessionRefreshTokens SessionRefreshToken[]

  @@map("users")
}

model Partner {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version     Int      @default(1)

  user User @relation(fields: [userId], references: [id])

  @@map("partners")
}

// ─── Catalog ───────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  country     String
  contactJson Json?    @map("contact_json")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version     Int      @default(1)

  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  // Optional Arabic name (BUSINESS_LOGIC §3, owner 2026-10-14). Unique when
  // present, ignoring case, through the partial index `categories_name_ar_key`
  // on lower(name_ar), which Prisma cannot express.
  nameAr    String?  @map("name_ar")
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version   Int      @default(1)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique
  name          String
  // Optional Arabic name and description (BUSINESS_LOGIC §3, owner
  // 2026-10-14). Shown to an Arabic reader when present, the English otherwise.
  nameAr        String?  @map("name_ar")
  // `arabicSearchKey(nameAr)` (common/arabic-names.ts, §3 2026-10-15): what a
  // search compares, because `contains` cannot fold أ/ا, ة/ه, ى/ي or marks.
  // Written beside nameAr on every write, never shown, omitted from every
  // query result by PrismaService. Postgres's `arabic_search_key()` is the
  // same rule for the backfill and check-data.
  nameArSearch  String?  @map("name_ar_search")
  categoryId    String?  @map("category_id") @db.Uuid
  description   String?
  descriptionAr String?  @map("description_ar")
  barcode       String?
  status        String   @default("ACTIVE")
  minStock      Decimal? @map("min_stock") @db.Decimal(18, 3)
  unitWeightKg  Decimal? @map("unit_weight_kg") @db.Decimal(18, 3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version       Int      @default(1)

  category           Category?              @relation(fields: [categoryId], references: [id])
  suppliers          ProductSupplier[]
  compatibilities    ProductCompatibility[]
  prices             ProductPrice[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryBatches   InventoryBatch[]
  saleItems          SaleItem[]
  productRequests    ProductRequest[]
  fileAssets         FileAsset[]
  orderRequestItems  OrderRequestItem[]
  stockTransferLines StockTransferLine[]

  @@map("products")
}

model ProductSupplier {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  supplierSku String?  @map("supplier_sku")
  sourceUrl   String?  @map("source_url")
  preferred   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId, supplierSku])
  @@map("product_suppliers")
}

model MotorcycleModel {
  id        String   @id @default(uuid()) @db.Uuid
  make      String
  model     String
  yearFrom  Int?     @map("year_from")
  yearTo    Int?     @map("year_to")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  compatibilities ProductCompatibility[]

  @@map("motorcycle_models")
}

model ProductCompatibility {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  motorcycleModelId String   @map("motorcycle_model_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  product         Product         @relation(fields: [productId], references: [id])
  motorcycleModel MotorcycleModel @relation(fields: [motorcycleModelId], references: [id])

  @@unique([productId, motorcycleModelId])
  @@map("product_compatibilities")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  channel       String
  currency      String
  amount        Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz()
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy     String?   @map("created_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id])

  @@map("product_prices")
}

enum AssetVariant {
  ORIGINAL
  CARD
  THUMB
}

/**
 * An image, and the thing it belongs to.
 * `owner_type` / `owner_id` was polymorphic in name only: `owner_id` carried a
 * foreign key to `products`, so a photo attached to anything else failed the
 * constraint. Two explicit nullable columns instead — integrity is kept, and
 * what a file can belong to is legible from the schema rather than from
 * whatever strings the callers happen to pass.
 */
model FileAsset {
  id        String       @id @default(uuid()) @db.Uuid
  objectKey String       @map("object_key")
  /**
   * Sniffed from the leading bytes, not taken from the caller.
   */
  mimeType  String       @map("mime_type")
  sizeBytes Int          @map("size_bytes")
  variant   AssetVariant @default(ORIGINAL)
  width     Int?
  height    Int?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  /**
   * Derivatives point at the original they were resized from.
   */
  parentAssetId String?     @map("parent_asset_id") @db.Uuid
  parentAsset   FileAsset?  @relation("AssetDerivatives", fields: [parentAssetId], references: [id], onDelete: Cascade)
  derivatives   FileAsset[] @relation("AssetDerivatives")

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  productRequestId String?         @map("product_request_id") @db.Uuid
  productRequest   ProductRequest? @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  /**
   * Who uploaded it, so a customer's photo is attributable.
   */
  uploadedBy String? @map("uploaded_by") @db.Uuid

  @@index([productId])
  @@index([productRequestId])
  @@map("file_assets")
}

// ─── Supply Chain ──────────────────────────────────────────────────

enum ParticipantType {
  CORE_PARTNER
  TEMP_INVESTOR
}

enum ShippingCostBasis {
  PER_PIECE
  PER_WEIGHT
  FLAT
}

enum CycleOriginType {
  CHINA
  UAE_DIRECT
}

enum CycleStatus {
  PLANNING
  FUNDING
  PURCHASING
  IN_TRANSIT
  ARRIVED_UAE
  IN_TRANSIT_TO_EGYPT
  ARRIVED_EGYPT
  VERIFICATION
  SELLING
  SETTLEMENT
  CLOSED
  CANCELLED
}

model ImportCycle {
  id         String          @id @default(uuid()) @db.Uuid
  code       String          @unique
  status     CycleStatus     @default(PLANNING)
  originType CycleOriginType @map("origin_type")
  currency   String
  startedOn  DateTime?       @map("started_on") @db.Date
  closedOn   DateTime?       @map("closed_on") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  version    Int             @default(1)

  participants          CycleParticipant[]
  purchaseOrders        PurchaseOrder[]
  shippingLegs          ShippingLeg[]
  inventoryBatches      InventoryBatch[]
  financialTransactions FinancialTransaction[]
  settlements           Settlement[]
  lenderFinancings      LenderFinancing[]
  /// Leftover stock moved out of this cycle, and into it (§8, L5).
  transfersOut          StockTransfer[]        @relation("TransferFromCycle")
  transfersIn           StockTransfer[]        @relation("TransferToCycle")

  @@map("import_cycles")
}

model CycleParticipant {
  id                 String          @id @default(uuid()) @db.Uuid
  cycleId            String          @map("cycle_id") @db.Uuid
  participantType    ParticipantType @map("participant_type")
  partnerUserId      String?         @map("partner_user_id") @db.Uuid
  investorUserId     String?         @map("investor_user_id") @db.Uuid
  contributionAmount Decimal         @map("contribution_amount") @db.Decimal(18, 2)
  customProfitPct    Decimal?        @map("custom_profit_pct") @db.Decimal(8, 4)
  investorFeePct     Decimal?        @map("investor_fee_pct") @db.Decimal(8, 4)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  version            Int             @default(1)

  cycle              ImportCycle         @relation(fields: [cycleId], references: [id])
  partner            User?               @relation("CyclePartnerUser", fields: [partnerUserId], references: [id])
  investor           User?               @relation("CycleInvestorUser", fields: [investorUserId], references: [id])
  settlementLines    SettlementLine[]
  runningCostCharges RunningCostCharge[]

  // A person joins a cycle once. Without this a double-add silently dilutes
  // every other participant's profit share.
  @@unique([cycleId, partnerUserId])
  @@unique([cycleId, investorUserId])
  @@map("cycle_participants")
}

model PurchaseOrder {
  id                 String   @id @default(uuid()) @db.Uuid
  cycleId            String   @map("cycle_id") @db.Uuid
  supplierId         String   @map("supplier_id") @db.Uuid
  reference          String
  currency           String
  fxRateToEgp        Decimal  @map("fx_rate_to_egp") @db.Decimal(18, 4)
  orderedOn          DateTime @map("ordered_on") @db.Date
  status             String   @default("DRAFT")
  /// The supplier's own invoice number, trimmed and upper-cased. Unique per
  /// supplier so one receipt cannot become two orders; NULL for a receipt with
  /// no number (Postgres treats NULLs as distinct, so those are never checked).
  supplierInvoiceRef String?  @map("supplier_invoice_ref")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version            Int      @default(1)

  cycle            ImportCycle         @relation(fields: [cycleId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  supplierRefunds  SupplierRefund[]
  /// Friends who paid the supplier for all or part of this order (§18).
  lenderFinancings LenderFinancing[]

  @@unique([supplierId, supplierInvoiceRef])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  orderedQty      Decimal  @map("ordered_qty") @db.Decimal(18, 3)
  receivedQty     Decimal? @map("received_qty") @db.Decimal(18, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 4)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  product          Product                 @relation(fields: [productId], references: [id])
  /// One per receipt. Used to be one per order line (`@unique`); a line now
  /// arrives in several deliveries, each received as its own batch (§3).
  inventoryBatches InventoryBatch[]
  departureLines   ShipmentDepartureLine[]
  deliveryLines    ShipmentDeliveryLine[]
  losses           ShipmentLoss[]

  @@map("purchase_order_items")
}

model SupplierRefund {
  id                      String    @id @default(uuid()) @db.Uuid
  purchaseOrderId         String    @map("purchase_order_id") @db.Uuid
  amount                  Decimal   @db.Decimal(18, 2)
  currency                String
  fxRateToEgp             Decimal   @map("fx_rate_to_egp") @db.Decimal(18, 4)
  reason                  String?
  recordedOn              DateTime  @map("recorded_on") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy               String?   @map("created_by") @db.Uuid
  /// Set when the refund compensates goods lost on the way (§6, 2026-10-10).
  /// Refunds on one loss never total more than its cost.
  shipmentLossId          String?   @map("shipment_loss_id") @db.Uuid
  /// Who paid a loss refund when it was the leg's shipping company; null means
  /// the order's supplier, as every refund before losses were refundable.
  payerShippingProviderId String?   @map("payer_shipping_provider_id") @db.Uuid
  /// Set when the refund was undone (§6, §9, 2026-10-10): the money was
  /// handed back. The refund row stays; a balancing ledger OUTFLOW
  /// (`reversalTransactionId`) points back at its original inflow. A reversed
  /// refund counts toward no cap and no profit.
  reversedAt              DateTime? @map("reversed_at") @db.Timestamptz()
  reversedBy              String?   @map("reversed_by") @db.Uuid
  reversalReason          String?   @map("reversal_reason")
  /// The balancing ledger row. Null on a reversed refund that never had a
  /// ledger inflow to balance (refunds recorded before the ledger write).
  reversalTransactionId   String?   @unique @map("reversal_transaction_id") @db.Uuid

  purchaseOrder         PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  reversalTransaction   FinancialTransaction? @relation("SupplierRefundReversal", fields: [reversalTransactionId], references: [id], onDelete: Restrict)
  /// Restrict: a refunded loss cannot be taken back (LOSS_REFUNDED); the
  /// database refuses it too.
  shipmentLoss          ShipmentLoss?         @relation(fields: [shipmentLossId], references: [id], onDelete: Restrict)
  payerShippingProvider Provider?             @relation(fields: [payerShippingProviderId], references: [id], onDelete: Restrict)

  @@index([shipmentLossId])
  @@index([payerShippingProviderId])
  @@map("supplier_refunds")
}

enum RefundMethod {
  /**
   * Reduces what the customer owes. The default: most returns are from shops
   * with a running balance, and no cash needs to move.
   */
  CREDIT_NOTE
  /**
   * Money actually leaves, so it reaches the ledger as an outflow.
   */
  CASH
}

model SaleReturn {
  id              String       @id @default(uuid()) @db.Uuid
  saleOrderId     String       @map("sale_order_id") @db.Uuid
  reference       String       @unique
  returnedOn      DateTime     @map("returned_on") @db.Date
  reason          String
  refundMethod    RefundMethod @default(CREDIT_NOTE) @map("refund_method")
  /**
   * Sum of the refunded line amounts.
   */
  refundEgp       Decimal      @map("refund_egp") @db.Decimal(18, 2)
  /**
   * COGS put back, so cycle profit corrects itself.
   */
  cogsReversedEgp Decimal      @map("cogs_reversed_egp") @db.Decimal(18, 2)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  createdBy       String?      @map("created_by") @db.Uuid

  saleOrder SaleOrder        @relation(fields: [saleOrderId], references: [id])
  creator   User?            @relation("CreatedSaleReturnUser", fields: [createdBy], references: [id])
  items     SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  saleReturnId     String  @map("sale_return_id") @db.Uuid
  saleItemId       String  @map("sale_item_id") @db.Uuid
  /**
   * The batch the units came from, so they go back at the cost they left at
   * rather than at today's price.
   */
  inventoryBatchId String  @map("inventory_batch_id") @db.Uuid
  qty              Decimal @db.Decimal(18, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)
  refundEgp        Decimal @map("refund_egp") @db.Decimal(18, 2)
  unitCostEgp      Decimal @map("unit_cost_egp") @db.Decimal(18, 4)
  cogsReversedEgp  Decimal @map("cogs_reversed_egp") @db.Decimal(18, 2)
  /**
   * False when goods come back damaged and are written off instead.
   */
  restocked        Boolean @default(true)

  saleReturn     SaleReturn     @relation(fields: [saleReturnId], references: [id])
  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id])
  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])

  @@map("sale_return_items")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/**
 * An agreed schedule for clearing a shop's running balance.
 * The plan is per customer, not per sale: a shop thinks in terms of what it
 * owes you in total, and pays against that. Instalment amounts are whatever was
 * agreed — 20,000 might be settled as 10,000 up front then 1,000, 5,000 and
 * 4,000 on the next three Sundays — so nothing here divides evenly or assumes a
 * fixed weekly figure.
 */
model PaymentPlan {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  reference  String            @unique
  /**
   * The balance this plan was agreed to cover.
   */
  totalEgp   Decimal           @map("total_egp") @db.Decimal(18, 2)
  agreedOn   DateTime          @map("agreed_on") @db.Date
  status     PaymentPlanStatus @default(ACTIVE)
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  createdBy  String?           @map("created_by") @db.Uuid
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  /**
   * The sale this plan was agreed for, when it came from the sale's Contract
   * button (BUSINESS_LOGIC §7, 2026-10-16). Null for a plan agreed against the
   * shop's whole balance. One plan per sale; a cancelled plan lets go of it.
   */
  saleOrderId String? @unique @map("sale_order_id") @db.Uuid

  customer    Customer                @relation(fields: [customerId], references: [id])
  creator     User?                   @relation("CreatedPaymentPlanUser", fields: [createdBy], references: [id])
  saleOrder   SaleOrder?              @relation(fields: [saleOrderId], references: [id])
  instalments PaymentPlanInstalment[]

  @@map("payment_plans")
}

model PaymentPlanInstalment {
  id       String   @id @default(uuid()) @db.Uuid
  planId   String   @map("plan_id") @db.Uuid
  sequence Int
  /**
   * Usually a Sunday, but nothing enforces that — an upfront payment is just
   * the first instalment dated on the day the plan was agreed.
   */
  dueOn    DateTime @map("due_on") @db.Date
  amount   Decimal  @db.Decimal(18, 2)
  note     String?

  plan PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@map("payment_plan_instalments")
}

model Provider {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  shippingLegs ShippingLeg[]
  lossRefunds  SupplierRefund[]

  @@map("providers")
}

model ShippingLeg {
  id                 String            @id @default(uuid()) @db.Uuid
  cycleId            String            @map("cycle_id") @db.Uuid
  sequence           Int
  origin             String
  destination        String
  provider           String?
  providerId         String?           @map("provider_id") @db.Uuid
  trackingRef        String?           @map("tracking_ref")
  /// PENDING · PARTLY_DEPARTED · IN_TRANSIT · PARTLY_ARRIVED · ARRIVED
  /// (LEG_STATUSES in common/shipment-position.ts). A reading of the
  /// departures and deliveries, never a value anyone sets (§1).
  status             String            @default("PENDING")
  /// The day of the leg's first departure (L8, 2026-10-12): a reading of
  /// `departures`, written by `syncLegStatuses`, never set by hand.
  departedOn         DateTime?         @map("departed_on") @db.Timestamptz()
  arrivedOn          DateTime?         @map("arrived_on") @db.Timestamptz()
  // Costing basis: shipping is usually charged per piece, sometimes by weight.
  costBasis          ShippingCostBasis @default(FLAT) @map("cost_basis")
  ratePerUnit        Decimal?          @map("rate_per_unit") @db.Decimal(18, 4)
  chargeablePieces   Decimal?          @map("chargeable_pieces") @db.Decimal(18, 3)
  chargeableWeightKg Decimal?          @map("chargeable_weight_kg") @db.Decimal(18, 3)
  currency           String            @default("EGP")
  fxRateToEgp        Decimal           @default(1) @map("fx_rate_to_egp") @db.Decimal(18, 4)
  amount             Decimal?          @db.Decimal(18, 2)
  amountEgp          Decimal?          @map("amount_egp") @db.Decimal(18, 2)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  version            Int               @default(1)

  cycle          ImportCycle         @relation(fields: [cycleId], references: [id])
  providerRecord Provider?           @relation(fields: [providerId], references: [id])
  departures     ShipmentDeparture[]
  deliveries     ShipmentDelivery[]
  losses         ShipmentLoss[]

  @@unique([cycleId, sequence])
  @@map("shipping_legs")
}

/// Goods leaving a leg's origin on one day (BUSINESS_LOGIC §1, L8 —
/// 2026-10-12). A supplier may ship part of an order now and the rest later,
/// and Dubai may forward only part of what arrived, so a leg has any number of
/// these, as it has deliveries. A leg's `departedOn` and `status` are read
/// from them through `shipmentPosition`, never set by hand.
model ShipmentDeparture {
  id         String   @id @default(uuid()) @db.Uuid
  legId      String   @map("leg_id") @db.Uuid
  /// The calendar day it left, in Cairo.
  departedOn DateTime @map("departed_on") @db.Date
  note       String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  leg   ShippingLeg             @relation(fields: [legId], references: [id])
  lines ShipmentDepartureLine[]

  @@index([legId])
  @@map("shipment_departures")
}

/// How many of one ordered product left on a departure. The same order line
/// appears at most once per departure.
model ShipmentDepartureLine {
  id                  String  @id @default(uuid()) @db.Uuid
  departureId         String  @map("departure_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  qty                 Decimal @db.Decimal(18, 3)

  departure         ShipmentDeparture @relation(fields: [departureId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([departureId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("shipment_departure_lines")
}

/// One arrival of goods at the end of a leg (BUSINESS_LOGIC §1, 2026-10-10).
/// A leg's goods arrive in pieces, weeks apart, so a leg
/// has any number of these. A leg's `status` and `arrivedOn` are read from
/// them through `shipmentPosition`, never set by hand.
model ShipmentDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  legId     String   @map("leg_id") @db.Uuid
  /// The calendar day it arrived, in Cairo.
  arrivedOn DateTime @map("arrived_on") @db.Date
  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  leg   ShippingLeg            @relation(fields: [legId], references: [id])
  lines ShipmentDeliveryLine[]

  @@index([legId])
  @@map("shipment_deliveries")
}

/// How many of one ordered product a delivery brought. The same order line
/// appears at most once per delivery.
model ShipmentDeliveryLine {
  id                  String  @id @default(uuid()) @db.Uuid
  deliveryId          String  @map("delivery_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  qty                 Decimal @db.Decimal(18, 3)

  delivery          ShipmentDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  /// Not unique: a delivery line can be received in several goes, up to what
  /// it brought (spec amendment 1).
  inventoryBatches  InventoryBatch[]

  @@unique([deliveryId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("shipment_delivery_lines")
}

/// Units a partner marked lost on a leg (§1, §2). Not a ledger row: no money
/// moves (§9). Settlement and analytics both subtract it through one function.
model ShipmentLoss {
  id                  String   @id @default(uuid()) @db.Uuid
  legId               String   @map("leg_id") @db.Uuid
  purchaseOrderItemId String   @map("purchase_order_item_id") @db.Uuid
  qty                 Decimal  @db.Decimal(18, 3)
  /// The line's landed unit cost when it was marked.
  unitCostEgp         Decimal  @map("unit_cost_egp") @db.Decimal(18, 4)
  costEgp             Decimal  @map("cost_egp") @db.Decimal(18, 2)
  reason              String?
  createdBy           String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  leg               ShippingLeg       @relation(fields: [legId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  refunds           SupplierRefund[]

  @@index([legId])
  @@index([purchaseOrderItemId])
  @@map("shipment_losses")
}

// ─── Inventory ─────────────────────────────────────────────────────

enum InventoryMovementType {
  RECEIVE
  RESERVE
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
  WRITE_OFF
  /// Leftover stock moved to another cycle at its cost (§8, L5), and back when undone.
  TRANSFER_OUT
  TRANSFER_IN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model InventoryBatch {
  id                     String             @id @default(uuid()) @db.Uuid
  cycleId                String             @map("cycle_id") @db.Uuid
  productId              String             @map("product_id") @db.Uuid
  sourcePoItemId         String?            @map("source_po_item_id") @db.Uuid
  /// The last-leg delivery line this batch was received from. Not unique: one
  /// delivery line can be received in several goes.
  sourceDeliveryLineId   String?            @map("source_delivery_line_id") @db.Uuid
  /// The day the delivery that brought it reached Egypt (§14).
  arrivedOn              DateTime?          @map("arrived_on") @db.Date
  /// The batch on another cycle these units were moved from (§8, L5). Null for
  /// stock this cycle received itself.
  transferredFromBatchId String?            @map("transferred_from_batch_id") @db.Uuid
  receivedQty            Decimal            @map("received_qty") @db.Decimal(18, 3)
  remainingQty           Decimal            @map("remaining_qty") @db.Decimal(18, 3)
  reservedQty            Decimal            @default(0) @map("reserved_qty") @db.Decimal(18, 3)
  saleableQty            Decimal            @map("saleable_qty") @db.Decimal(18, 3)
  landedUnitCostEgp      Decimal            @map("landed_unit_cost_egp") @db.Decimal(18, 4)
  verificationStatus     VerificationStatus @default(PENDING) @map("verification_status")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  version                Int                @default(1)

  cycle               ImportCycle            @relation(fields: [cycleId], references: [id])
  product             Product                @relation(fields: [productId], references: [id])
  sourcePoItem        PurchaseOrderItem?     @relation(fields: [sourcePoItemId], references: [id])
  sourceDeliveryLine  ShipmentDeliveryLine?  @relation(fields: [sourceDeliveryLineId], references: [id])
  transferredFrom     InventoryBatch?        @relation("BatchTransfer", fields: [transferredFromBatchId], references: [id])
  transferredTo       InventoryBatch[]       @relation("BatchTransfer")
  transferLinesOut    StockTransferLine[]    @relation("TransferSourceBatch")
  transferLinesIn     StockTransferLine[]    @relation("TransferDestBatch")
  movements           InventoryMovement[]
  reservations        InventoryReservation[]
  saleItemAllocations SaleItemAllocation[]
  returnItems         SaleReturnItem[]

  @@index([sourcePoItemId])
  @@index([sourceDeliveryLineId])
  @@index([transferredFromBatchId])
  @@map("inventory_batches")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @map("batch_id") @db.Uuid
  movementType  InventoryMovementType @map("movement_type")
  qtyDelta      Decimal               @map("qty_delta") @db.Decimal(18, 3)
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  occurredAt    DateTime              @default(now()) @map("occurred_at") @db.Timestamptz()
  createdBy     String?               @map("created_by") @db.Uuid

  batch InventoryBatch @relation(fields: [batchId], references: [id])
  actor User?          @relation(fields: [createdBy], references: [id])

  @@map("inventory_movements")
}

// ─── Leftover stock moved between cycles (BUSINESS_LOGIC §8, L5) ─────

enum StockTransferStatus {
  ACTIVE
  /// Undone: the units went back to the source cycle's batches.
  REVERSED
}

/// Leftover units moved from one cycle to another at exactly their landed
/// cost. The source cycle recovers the cost (no profit, no loss on them); the
/// target cycle's partners fund it. Never edited: undone, with a reason.
model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  fromCycleId    String              @map("from_cycle_id") @db.Uuid
  toCycleId      String              @map("to_cycle_id") @db.Uuid
  /// The Cairo day the units were moved.
  movedOn        DateTime            @map("moved_on") @db.Date
  reason         String
  status         StockTransferStatus @default(ACTIVE)
  createdBy      String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  reversedAt     DateTime?           @map("reversed_at") @db.Timestamptz()
  reversedBy     String?             @map("reversed_by") @db.Uuid
  reversalReason String?             @map("reversal_reason")

  fromCycle ImportCycle         @relation("TransferFromCycle", fields: [fromCycleId], references: [id])
  toCycle   ImportCycle         @relation("TransferToCycle", fields: [toCycleId], references: [id])
  actor     User                @relation("StockTransferCreatedBy", fields: [createdBy], references: [id])
  reverser  User?               @relation("StockTransferReversedBy", fields: [reversedBy], references: [id])
  lines     StockTransferLine[]

  @@index([fromCycleId])
  @@index([toCycleId])
  @@map("stock_transfers")
}

/// One source batch's units in a transfer, and the batch they became.
model StockTransferLine {
  id            String  @id @default(uuid()) @db.Uuid
  transferId    String  @map("transfer_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  sourceBatchId String  @map("source_batch_id") @db.Uuid
  /// The new batch on the target cycle; null once the transfer is undone and
  /// that batch removed.
  destBatchId   String? @unique @map("dest_batch_id") @db.Uuid
  qty           Decimal @db.Decimal(18, 3)
  /// The source batch's landed unit cost — never re-priced.
  unitCostEgp   Decimal @map("unit_cost_egp") @db.Decimal(18, 4)
  costEgp       Decimal @map("cost_egp") @db.Decimal(18, 2)

  transfer    StockTransfer   @relation(fields: [transferId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  sourceBatch InventoryBatch  @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id])
  destBatch   InventoryBatch? @relation("TransferDestBatch", fields: [destBatchId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([sourceBatchId])
  @@map("stock_transfer_lines")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

/**
 * Stock set aside, either for an order or for a request awaiting an answer.
 * `sale_order_id` was required, so this could only ever hold for something that
 * was already an order — which is why the table sat unused. A request holds
 * stock before an order exists; that is the whole point of a hold.
 * Exactly one of the two is set, enforced by a check constraint rather than by
 * hope.
 */
model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  batchId        String            @map("batch_id") @db.Uuid
  saleOrderId    String?           @map("sale_order_id") @db.Uuid
  orderRequestId String?           @map("order_request_id") @db.Uuid
  qty            Decimal           @db.Decimal(18, 3)
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz()
  releasedAt     DateTime?         @map("released_at") @db.Timestamptz()
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  batch        InventoryBatch @relation(fields: [batchId], references: [id])
  saleOrder    SaleOrder?     @relation(fields: [saleOrderId], references: [id])
  orderRequest OrderRequest?  @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// ─── Sales & Customers ─────────────────────────────────────────────

enum CustomerType {
  B2B
  B2C
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
  RETURNED
}

model Customer {
  id                 String       @id @default(uuid()) @db.Uuid
  type               CustomerType
  displayName        String       @map("display_name")
  phone              String?
  email              String?
  // Unique: one login belongs to one shop. Without it two customers could
  // name the same portal user, and a session would see whichever the query
  // happened to return first — an ownership bug that reads as a caching one.
  shopOwnerUserId    String?      @unique @map("shop_owner_user_id") @db.Uuid
  verificationStatus String       @default("UNVERIFIED") @map("verification_status")
  // The one shared record behind every walk-in sale (BUSINESS_LOGIC §4,
  // 2026-10-11). At most one row may carry true: the migration adds a unique
  // index WHERE is_walk_in, which Prisma cannot express, so two first walk-in
  // sales at once cannot make two of it. Found or made by `walkInCustomer`.
  isWalkIn           Boolean      @default(false) @map("is_walk_in")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  version            Int          @default(1)

  saleOrders      SaleOrder[]
  payments        Payment[]
  productRequests ProductRequest[]

  // `shop_owner_user_id` has existed since the first migration with no foreign
  // key behind it, so it could name a user that was never there. The portal
  // login reads it to decide whose data a session may see, which is not a
  // column to leave unenforced.
  shopOwner User? @relation("PortalAccount", fields: [shopOwnerUserId], references: [id])

  orderRequests OrderRequest[]

  paymentPlans PaymentPlan[]

  @@map("customers")
}

model SaleOrder {
  id          String      @id @default(uuid()) @db.Uuid
  orderNo     String      @unique
  customerId  String      @map("customer_id") @db.Uuid
  channel     String
  status      OrderStatus @default(DRAFT)
  currency    String
  subtotal    Decimal     @db.Decimal(18, 2)
  discount    Decimal     @default(0) @db.Decimal(18, 2)
  total       Decimal     @db.Decimal(18, 2)
  outstanding Decimal     @db.Decimal(18, 2)
  orderedAt   DateTime    @default(now()) @map("ordered_at") @db.Timestamptz()
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  version     Int         @default(1)

  customer           Customer               @relation(fields: [customerId], references: [id])
  creator            User?                  @relation("CreatedSaleOrderUser", fields: [createdBy], references: [id])
  createdBy          String?                @map("created_by") @db.Uuid
  /// The create form's key, so a retried POST returns this order instead of a
  /// second one. Unique per person: two people's keys never answer for each other.
  idempotencyKey     String?                @map("idempotency_key")
  items              SaleItem[]
  reservations       InventoryReservation[]
  paymentAllocations PaymentAllocation[]

  returns SaleReturn[]

  orderRequest OrderRequest?
  /// The instalment plan agreed from this sale's Contract button (§7, 2026-10-16).
  paymentPlan  PaymentPlan?

  @@unique([createdBy, idempotencyKey])
  @@map("sale_orders")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleOrderId String   @map("sale_order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 2)
  discount    Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  saleOrder   SaleOrder            @relation(fields: [saleOrderId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  allocations SaleItemAllocation[]
  returnItems SaleReturnItem[]

  @@map("sale_items")
}

model SaleItemAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  saleItemId       String   @map("sale_item_id") @db.Uuid
  inventoryBatchId String   @map("inventory_batch_id") @db.Uuid
  qty              Decimal  @db.Decimal(18, 3)
  unitCostEgp      Decimal  @map("unit_cost_egp") @db.Decimal(18, 4)
  cogsEgp          Decimal  @map("cogs_egp") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id])
  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])

  @@map("sale_item_allocations")
}

model Payment {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  amount     Decimal  @db.Decimal(18, 2)
  currency   String
  receivedOn DateTime @map("received_on") @db.Date
  method     String?
  reference  String?
  status     String   @default("RECORDED")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  version    Int      @default(1)

  customer    Customer            @relation(fields: [customerId], references: [id])
  creator     User?               @relation("CreatedPaymentUser", fields: [createdBy], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  saleOrderId String   @map("sale_order_id") @db.Uuid
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payment   Payment   @relation(fields: [paymentId], references: [id])
  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id])

  @@map("payment_allocations")
}

// ─── Finance & Ledger ──────────────────────────────────────────────

enum TransactionDirection {
  INFLOW
  OUTFLOW
}

model FinancialTransaction {
  id               String               @id @default(uuid()) @db.Uuid
  type             String
  category         String
  direction        TransactionDirection
  amount           Decimal              @db.Decimal(18, 2)
  currency         String
  fxRateToEgp      Decimal?             @map("fx_rate_to_egp") @db.Decimal(18, 4)
  cycleId          String?              @map("cycle_id") @db.Uuid
  relatedType      String?              @map("related_type")
  relatedId        String?              @map("related_id") @db.Uuid
  reversalOfId     String?              @map("reversal_of_id") @db.Uuid
  reason           String?
  /// The Cairo day the money moved, for a manual entry (§9, L6). Null on rows
  /// written before it existed and on rows a flow writes, which read createdAt.
  occurredOn       DateTime?            @map("occurred_on") @db.Date
  /// What was actually paid, when it was not pounds: `amount` is always the
  /// pounds figure the settlement and the dashboard sum (§9, L6).
  originalAmount   Decimal?             @map("original_amount") @db.Decimal(18, 2)
  originalCurrency String?              @map("original_currency")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  createdBy        String?              @map("created_by") @db.Uuid

  cycle              ImportCycle?        @relation(fields: [cycleId], references: [id])
  actor              User?               @relation(fields: [createdBy], references: [id])
  /// The supplier refund this row undid, when it is a refund's reversal.
  reversedRefund     SupplierRefund?     @relation("SupplierRefundReversal")
  /// A general running cost: which payouts took it, and how much (§8, L7).
  runningCostCharges RunningCostCharge[]
  /// Who owes it, fixed once over the core partners of its day (§8, L7).
  runningCostShares  RunningCostShare[]

  @@map("financial_transactions")
}

// ─── Lenders (BUSINESS_LOGIC §18) ─────────────────────────────────

/// A friend who pays a supplier for us and is repaid in pounds. Not a partner,
/// not a customer, not a supplier: he shares in no profit (§18).
model Lender {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  notes     String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// Set when he was deleted (owner, 2026-10-18): hidden from every list and
  /// picker; kept so a removed payment's history still names him.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  financings LenderFinancing[]

  @@map("lenders")
}

/// What a friend paid a supplier on one purchase order, in that order's
/// currency — what we owe him until it reaches zero (§18). A standing one has
/// no `removedAt`; one friend has at most one standing financing per order
/// (a partial unique index in the migration, which Prisma cannot express).
model LenderFinancing {
  id                   String    @id @default(uuid()) @db.Uuid
  lenderId             String    @map("lender_id") @db.Uuid
  purchaseOrderId      String    @map("purchase_order_id") @db.Uuid
  /// The order's cycle. An order never changes cycle; kept for the gates.
  cycleId              String    @map("cycle_id") @db.Uuid
  /// The currency he paid in — not necessarily the order's (§18, 2026-10-16).
  currency             String
  amount               Decimal   @db.Decimal(18, 2)
  /// His currency's rate on the day he paid (the order's when none was given;
  /// before 2026-10-16 always the order's). The debt is valued at it.
  fxRateToEgp          Decimal   @map("fx_rate_to_egp") @db.Decimal(18, 4)
  /// amount × fxRateToEgp, half up — the ledger inflow.
  amountEgp            Decimal   @map("amount_egp") @db.Decimal(18, 2)
  /// The Cairo day he paid the supplier.
  paidOn               DateTime  @map("paid_on") @db.Date
  note                 String?
  createdBy            String?   @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  ledgerTransactionId  String?   @unique @map("ledger_transaction_id") @db.Uuid
  removedAt            DateTime? @map("removed_at") @db.Timestamptz()
  removedBy            String?   @map("removed_by") @db.Uuid
  removalReason        String?   @map("removal_reason")
  removalTransactionId String?   @unique @map("removal_transaction_id") @db.Uuid

  lender        Lender            @relation(fields: [lenderId], references: [id])
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  cycle         ImportCycle       @relation(fields: [cycleId], references: [id])
  repayments    LenderRepayment[]
  plans         LenderPlan[]

  @@index([lenderId])
  @@index([purchaseOrderId])
  @@index([cycleId])
  @@map("lender_financings")
}

/// Pounds paid back to a friend on a day, at that day's rate (§18). Reversed,
/// never edited or deleted (§9); a standing one has no `reversedAt`.
model LenderRepayment {
  id                    String    @id @default(uuid()) @db.Uuid
  financingId           String    @map("financing_id") @db.Uuid
  paidOn                DateTime  @map("paid_on") @db.Date
  /// Pounds actually paid.
  amountEgp             Decimal   @map("amount_egp") @db.Decimal(18, 2)
  /// That day's rate, as entered.
  rateToEgp             Decimal   @map("rate_to_egp") @db.Decimal(18, 4)
  /// Debt cleared, in the financing's currency (common/lender-math.ts).
  cleared               Decimal   @db.Decimal(18, 2)
  /// What `cleared` was worth at the financing's own rate (the column keeps
  /// its old name; until 2026-10-16 that rate was always the order's).
  clearedAtOrderRateEgp Decimal   @map("cleared_at_order_rate_egp") @db.Decimal(18, 2)
  /// amountEgp − clearedAtOrderRateEgp: a cost when positive, a gain when
  /// negative. Counts in cycle profit; never an operating expense.
  exchangeDiffEgp       Decimal   @map("exchange_diff_egp") @db.Decimal(18, 2)
  note                  String?
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  ledgerTransactionId   String?   @unique @map("ledger_transaction_id") @db.Uuid
  reversedAt            DateTime? @map("reversed_at") @db.Timestamptz()
  reversedBy            String?   @map("reversed_by") @db.Uuid
  reversalReason        String?   @map("reversal_reason")
  reversalTransactionId String?   @unique @map("reversal_transaction_id") @db.Uuid

  financing LenderFinancing @relation(fields: [financingId], references: [id])

  @@index([financingId])
  @@map("lender_repayments")
}

/// An agreed schedule for repaying one financing, in its currency (§18, the
/// §7 habit). One ACTIVE per financing — a partial unique index.
model LenderPlan {
  id           String            @id @default(uuid()) @db.Uuid
  financingId  String            @map("financing_id") @db.Uuid
  agreedOn     DateTime          @map("agreed_on") @db.Date
  status       PaymentPlanStatus @default(ACTIVE)
  note         String?
  cancelReason String?           @map("cancel_reason")
  createdBy    String?           @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  financing   LenderFinancing        @relation(fields: [financingId], references: [id])
  instalments LenderPlanInstalment[]

  @@index([financingId])
  @@map("lender_plans")
}

model LenderPlanInstalment {
  id       String   @id @default(uuid()) @db.Uuid
  planId   String   @map("plan_id") @db.Uuid
  sequence Int
  dueOn    DateTime @map("due_on") @db.Date
  /// In the financing's currency.
  amount   Decimal  @db.Decimal(18, 2)

  plan LenderPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@map("lender_plan_instalments")
}

// ─── Settlement ────────────────────────────────────────────────────

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  REVERSED
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  cycleId        String           @map("cycle_id") @db.Uuid
  status         SettlementStatus @default(DRAFT)
  // Cycle profit and loss as calculated, kept so an approved settlement can be
  // read back exactly as it was agreed.
  revenueEgp     Decimal?         @map("revenue_egp") @db.Decimal(18, 2)
  cogsEgp        Decimal?         @map("cogs_egp") @db.Decimal(18, 2)
  expensesEgp    Decimal?         @map("expenses_egp") @db.Decimal(18, 2)
  grossProfitEgp Decimal?         @map("gross_profit_egp") @db.Decimal(18, 2)
  unsoldValueEgp Decimal?         @map("unsold_value_egp") @db.Decimal(18, 2)
  unitsSold      Decimal?         @map("units_sold") @db.Decimal(18, 3)
  unitsRemaining Decimal?         @map("units_remaining") @db.Decimal(18, 3)
  /// The cycle's costs line by line as calculated, summing to expensesEgp
  /// (§8 "a payout explains itself", L7). Null on settlements calculated before.
  costBreakdown  Json?            @map("cost_breakdown")
  calculatedAt   DateTime?        @map("calculated_at") @db.Timestamptz()
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz()
  paidAt         DateTime?        @map("paid_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  version        Int              @default(1)

  cycle              ImportCycle         @relation(fields: [cycleId], references: [id])
  lines              SettlementLine[]
  /// Running costs this settlement's payouts took (§8, L7).
  runningCostCharges RunningCostCharge[]

  @@map("settlements")
}

/// One core partner's payout taking part of one general running cost (§8, owner
/// 2026-10-11; built L7). Written when a settlement is marked paid; a cost is
/// charged once in total across the rows that stand. Reversing the settlement
/// releases them (`releasedAt`) -- the row stays, history is not rewritten --
/// and the cost is waiting again.
model RunningCostCharge {
  id            String    @id @default(uuid()) @db.Uuid
  /// The ledger row of the cost: an operating expense with no cycle.
  costEntryId   String    @map("cost_entry_id") @db.Uuid
  settlementId  String    @map("settlement_id") @db.Uuid
  /// The partner's line on the settlement whose payout took it.
  participantId String    @map("participant_id") @db.Uuid
  /// The core partner, across cycles: his share follows him, not the cycle.
  partnerUserId String    @map("partner_user_id") @db.Uuid
  amount        Decimal   @db.Decimal(18, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Set when the settlement is reversed: the charge no longer stands.
  releasedAt    DateTime? @map("released_at") @db.Timestamptz()

  costEntry   FinancialTransaction @relation(fields: [costEntryId], references: [id])
  settlement  Settlement           @relation(fields: [settlementId], references: [id])
  participant CycleParticipant     @relation(fields: [participantId], references: [id])
  partner     User                 @relation(fields: [partnerUserId], references: [id])

  @@unique([costEntryId, settlementId, partnerUserId])
  @@index([partnerUserId])
  @@index([settlementId])
  @@map("running_cost_charges")
}

/// Each core partner's share of one running cost, fixed once over the core
/// partners active on the cost's own day (§8, L7; alignment review
/// 2026-10-12). It never changes afterwards: a partner who leaves keeps owing
/// his, and one who joins later owes nothing of it. Rounded down to the
/// piastre, the residual on the partner of that day who joined last.
model RunningCostShare {
  id            String   @id @default(uuid()) @db.Uuid
  costEntryId   String   @map("cost_entry_id") @db.Uuid
  partnerUserId String   @map("partner_user_id") @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  costEntry FinancialTransaction @relation(fields: [costEntryId], references: [id])
  partner   User                 @relation(fields: [partnerUserId], references: [id])

  @@unique([costEntryId, partnerUserId])
  @@index([partnerUserId])
  @@map("running_cost_shares")
}

model SettlementLine {
  id                     String   @id @default(uuid()) @db.Uuid
  settlementId           String   @map("settlement_id") @db.Uuid
  participantId          String   @map("participant_id") @db.Uuid
  component              String
  amount                 Decimal  @db.Decimal(18, 2)
  feeAmount              Decimal? @map("fee_amount") @db.Decimal(18, 2)
  recipientParticipantId String?  @map("recipient_participant_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  settlement  Settlement       @relation(fields: [settlementId], references: [id])
  participant CycleParticipant @relation(fields: [participantId], references: [id])

  @@map("settlement_lines")
}

// ─── Notifications ─────────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  eventType   String    @map("event_type")
  /// What happened, as a key the reader's app translates (`notifications.<code>`
  /// in the web's locale files). NULL on rows written before U5 (2026-10-10):
  /// those carry only their English `title`, which is still shown as written.
  code        String?
  /// The values the translated text needs (`{ cycleCode: "CYC-…" }`).
  params      Json?
  /// The English text — what the logs record, and what a client that has
  /// never heard of `code` falls back to.
  title       String
  payloadJson Json?     @map("payload_json")
  readAt      DateTime? @map("read_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── Audit ─────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  correlationId String?  @map("correlation_id") @db.Uuid
  sourceIp      String?  @map("source_ip")
  userAgent     String?  @map("user_agent")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ─── Product Requests (Phase 2) ────────────────────────────────────

enum ProductRequestStatus {
  PENDING
  SOURCING
  ANSWERED
  DECLINED
  /**
   * The shop changed its own mind. Not the same as being turned down, and a
   * screen that showed it as DECLINED told a customer we had refused them.
   */
  CANCELLED
}

model ProductRequest {
  id                String               @id @default(uuid()) @db.Uuid
  customerId        String               @map("customer_id") @db.Uuid
  productName       String               @map("product_name")
  compatibilityText String?              @map("compatibility_text")
  quantity          Decimal?             @db.Decimal(18, 3)
  notes             String?
  supplierUrl       String?              @map("supplier_url")
  status            ProductRequestStatus @default(PENDING)
  /**
   * The owner's reply, shown to the shop.
   */
  decisionNote      String?              @map("decision_note")
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz()
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  /**
   * Photos of the part. `asset_id` held exactly one and had no relation
   * behind it; a shop photographs a part from three angles.
   */
  photos FileAsset[]

  customer  Customer @relation(fields: [customerId], references: [id])
  creator   User?    @relation("CreatedProductRequestUser", fields: [createdBy], references: [id])
  createdBy String?  @map("created_by") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @map("product_id") @db.Uuid

  @@map("product_requests")
}

// ─── Currency ──────────────────────────────────────────────────────

/**
 * The current rate for converting a foreign currency into EGP.
 * This is a lookup for prefilling forms, NOT a historical record. Every
 * document that involves a foreign amount stores the rate it was agreed at
 * (purchase orders, shipping legs, ledger entries all carry their own
 * fxRateToEgp), so changing a rate here never moves a figure that has already
 * been recorded — which is what BRD §10 requires of financial history.
 * `source` says where the number came from, so a rate typed by a partner is
 * distinguishable from one a scheduled job fetched.
 */
model CurrencyRate {
  code      String   @id
  // Null means "no rate known" — the form asks for one rather than guessing.
  rateToEgp Decimal? @map("rate_to_egp") @db.Decimal(18, 4)
  source    String   @default("manual")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("currency_rates")
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/**
 * A shop asking to buy, before it is an order.
 * Deliberately not a status on `SaleOrder`. Outstanding balances, analytics,
 * payment allocation, settlement projection and the customer balance screen all
 * read sale orders, and a `REQUESTED` value there would mean every one of them
 * has to learn to exclude it. The one that forgot would be silently wrong
 * money, which is the failure this repository has spent the most time on.
 * Approving calls the existing `sales.create` and `confirmOrder`. There is one
 * definition of how an order comes into being and this is not a second one.
 */
model OrderRequest {
  id           String             @id @default(uuid()) @db.Uuid
  requestNo    String             @unique @map("request_no")
  customerId   String             @map("customer_id") @db.Uuid
  status       OrderRequestStatus @default(PENDING)
  /**
   * What the shop wrote when submitting.
   */
  note         String?
  /**
   * The owner's answer, shown to the shop beside what changed.
   */
  decisionNote String?            @map("decision_note")

  /**
   * When the hold lapses. The request stays answerable past it; only the
   * units go back on the shelf.
   */
  holdExpiresAt  DateTime? @map("hold_expires_at") @db.Timestamptz()
  holdReleasedAt DateTime? @map("hold_released_at") @db.Timestamptz()
  /**
   * When the office was nudged that this is about to lapse. Stops the same
   * request alerting every half hour until it does — twelve identical alerts
   * is how people learn to ignore the bell.
   */
  holdWarnedAt   DateTime? @map("hold_warned_at") @db.Timestamptz()

  saleOrderId String?   @unique @map("sale_order_id") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz()
  decidedBy   String?   @map("decided_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  version     Int       @default(1)

  customer     Customer               @relation(fields: [customerId], references: [id])
  saleOrder    SaleOrder?             @relation(fields: [saleOrderId], references: [id])
  decider      User?                  @relation("DecidedOrderRequestUser", fields: [decidedBy], references: [id])
  items        OrderRequestItem[]
  reservations InventoryReservation[]

  @@index([customerId, status])
  @@index([status, holdExpiresAt])
  @@map("order_requests")
}

model OrderRequestItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderRequestId String   @map("order_request_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  qtyRequested   Decimal  @map("qty_requested") @db.Decimal(18, 3)
  /**
   * Null until decided. Zero means the line was dropped.
   */
  qtyApproved    Decimal? @map("qty_approved") @db.Decimal(18, 3)
  /**
   * The price the shop was shown when they asked. A price that moves between
   * request and approval must not change what they believed they were asking
   * for; the approval screen shows both when they differ.
   */
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)

  orderRequest OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("order_request_items")
}

/**
 * One browser that agreed to be notified.
 * Deleted on a 404 or 410 from the push service. Dead endpoints otherwise
 * accumulate for every phone that ever uninstalled the app, and each one is a
 * failed request on every send.
 */
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz()
  failureCount  Int       @default(0) @map("failure_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * A client (a Claude app) that registered itself through OAuth dynamic client
 * registration. Public clients only: no secret is issued, PKCE carries the proof.
 */
model OAuthClient {
  id           String   @id @default(uuid()) @db.Uuid
  clientName   String?  @map("client_name")
  redirectUris String[] @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  refreshTokens OAuthRefreshToken[]

  @@map("oauth_clients")
}

/**
 * One signed-in connection: a partner on one client. Only the SHA-256 of the
 * token is stored, never the token. Rotated on use; the spent row points at its
 * successor, so a replayed token can be traced and the chain revoked.
 */
model OAuthRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@map("oauth_refresh_tokens")
}

/**
 * An office sign-in that outlives its access token (owner, 2026-10-17:
 * "why do I have to log in every time I open it").
 *
 * Opaque, stored hashed, spent on every use. Every token descended from one
 * sign-in shares a `familyId`, so a spent token presented again ends that
 * sign-in on every device holding it (BUSINESS_LOGIC §23).
 */
model SessionRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("session_refresh_tokens")
}

/**
 * Single use for authorization codes and confirmation tokens: the jti is
 * written when spent, and a second spend trips the primary key.
 */
model UsedNonce {
  jti       String   @id
  /// 'oauth_code' | 'confirmation'
  kind      String
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz()
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  @@index([expiresAt])
  @@map("used_nonces")
}
